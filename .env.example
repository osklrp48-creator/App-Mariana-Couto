# Copie este arquivo para .env (local) e configure as mesmas variáveis em
# Vercel > Project Settings > Environment Variables para o deploy em produção.
#
# Encontre esses valores no painel do Supabase em:
# Project Settings > Data API (URL) e Project Settings > API Keys (anon / publishable key)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA_CHAVE_ANON_PUBLICA
